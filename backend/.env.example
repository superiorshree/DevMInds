# DevMinds backend environment variables — NAMES ONLY, no real values.
# Copy to `.env` (git-ignored) and fill in locally. See docs/SETUP.md.

# App
APP_NAME=devminds-backend
DEBUG=true
BACKEND_HOST=localhost
BACKEND_PORT=8000

# CORS — origins allowed to call the API (the Chrome extension origin)
CORS_ORIGINS=chrome-extension://<extension-id>,http://localhost:5173

# Database (optional for the local demo; models are stubs)
DATABASE_URL=sqlite:///./devminds.db

# GitHub OAuth — backend only, NEVER in the extension
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/api/auth/github/callback

# Session signing secret (HS256) — backend only, NEVER in the extension
SESSION_SECRET=

# chromiumapp.org URL the extension uses with chrome.identity.launchWebAuthFlow
# (Optional fallback or single-environment redirect URI)
EXTENSION_REDIRECT_URI=https://<extension-id>.chromiumapp.org/provide_cb.html

# Allowed Chrome extension IDs for OAuth redirects (comma-separated list of IDs or chromiumapp URLs)
# Different developers have different unpacked extension IDs when loaded in developer mode.
# Add your 32-character extension ID from chrome://extensions here to allow OAuth redirects.
ALLOWED_EXTENSION_IDS=

# LLM provider — backend only
AI_CHAT_ENABLED=true
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT_SECONDS=60
EXTERNAL_LLM_BASE_URL=
EXTERNAL_LLM_API_KEY=
EXTERNAL_LLM_MODEL=
EXTERNAL_LLM_TIMEOUT_SECONDS=30
ALLOW_EXTERNAL_FOR_COMPANY=false
USE_MOCK_INTEGRATIONS=true

# Jira Cloud Authentication
# Option A: API Token Auth (Server-to-Server / Basic Auth - recommended for backend services)
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=your-email@example.com
JIRA_API_TOKEN=your_jira_api_token_here

# Option B: Atlassian OAuth 2.0 (3LO - 3-Legged OAuth / User Sign-in)
# Created at https://developer.atlassian.com/console/myapps/
ATLASSIAN_CLIENT_ID=your_atlassian_oauth_client_id
ATLASSIAN_CLIENT_SECRET=your_atlassian_oauth_client_secret
ATLASSIAN_REDIRECT_URI=http://localhost:8000/api/auth/atlassian/callback
ATLASSIAN_CLOUD_ID=your_atlassian_cloud_site_id
JIRA_ACCESS_TOKEN=your_oauth_access_token_here
JIRA_REFRESH_TOKEN=your_oauth_refresh_token_here

# Confluence Cloud Authentication
# Option A: API Token Auth (Server-to-Server / Basic Auth)
CONFLUENCE_BASE_URL=https://your-domain.atlassian.net/wiki
CONFLUENCE_EMAIL=your-email@example.com
CONFLUENCE_API_TOKEN=your_confluence_api_token_here

# Option B: Confluence OAuth 2.0 (Uses same Atlassian Cloud ID and 3LO credentials)
CONFLUENCE_ACCESS_TOKEN=your_oauth_access_token_here
CONFLUENCE_REFRESH_TOKEN=your_oauth_refresh_token_here

# Slack Web API Authentication
# Created at https://api.slack.com/apps
SLACK_BOT_TOKEN=xoxb-your-bot-token-here
SLACK_USER_TOKEN=xoxp-your-user-token-here
SLACK_SIGNING_SECRET=your_slack_signing_secret_here
SLACK_CHANNEL_IDS=C0123456789
SLACK_CLIENT_ID=your_slack_client_id
SLACK_CLIENT_SECRET=your_slack_client_secret
SLACK_REDIRECT_URI=http://localhost:8000/api/auth/slack/callback

