# DevMinds backend environment variables — NAMES ONLY, no real values.
# Copy to `.env` (git-ignored) and fill in locally. See docs/SETUP.md.

# App
APP_NAME=devminds-backend
DEBUG=true
BACKEND_HOST=localhost
BACKEND_PORT=8000

# CORS — origins allowed to call the API (the Chrome extension origin)
CORS_ORIGINS=chrome-extension://<extension-id>,http://localhost:5173

# Database (optional for the local demo; models are stubs)
DATABASE_URL=sqlite:///./devminds.db

# GitHub OAuth — backend only, NEVER in the extension
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/api/auth/github/callback

# Session signing secret (HS256) — backend only, NEVER in the extension
SESSION_SECRET=

# chromiumapp.org URL the extension uses with chrome.identity.launchWebAuthFlow
EXTENSION_REDIRECT_URI=https://<extension-id>.chromiumapp.org/provider_cb.html

# LLM provider — backend only
AI_CHAT_ENABLED=true
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT_SECONDS=60
EXTERNAL_LLM_BASE_URL=
EXTERNAL_LLM_API_KEY=
EXTERNAL_LLM_MODEL=
EXTERNAL_LLM_TIMEOUT_SECONDS=30
ALLOW_EXTERNAL_FOR_COMPANY=false
USE_MOCK_INTEGRATIONS=true

# Jira (read-only) — company mode only
JIRA_BASE_URL=
JIRA_API_TOKEN=
JIRA_EMAIL=

# Confluence (read-only) — company mode only
CONFLUENCE_BASE_URL=
CONFLUENCE_API_TOKEN=
CONFLUENCE_EMAIL=

# Slack (one-way send of the architecture summary) — company mode only
SLACK_BOT_TOKEN=
SLACK_CHANNEL_IDS=
SLACK_SIGNING_SECRET=
